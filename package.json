{
  "name": "navette-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "node --test packages/*/test/*.test.ts",
    "test:e2e": "node e2e/run.mjs",
    "playground": "node apps/playground/server.ts",
    "release": "node scripts/release.mjs",
    "demo": "node apps/demo/server.ts",
    "starter": "node apps/starter/server.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "playwright": "^1.65.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NavetteJS/navette.git"
  }
}
