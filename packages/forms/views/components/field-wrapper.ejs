<%# Default field wrapper. `label` is HTML (escaped text, or the HTML of an HtmlString / JsContent label). %>
<div data-field-wrapper class="<%- wrapperClass %>"<%- locals.wrapperAttributes ?? '' %><% if (locals.focusable) { %> tabindex="-1"<% } %>>
    <% const hasLabelSlots = locals.aboveLabel || locals.beforeLabel || locals.belowLabel || locals.afterLabel; %>
    <% if (locals.hiddenLabel) { %>
        <% if (locals.labelAsDiv) { %>
            <div id="<%= id %>-label" class="nv-fo-field-label nv-sr-only">
                <%- label %>
            </div>
        <% } else { %>
        <label for="<%= id %>" class="nv-fo-field-label nv-sr-only">
            <%- label %>
        </label>
        <% } %>
    <% } %>
    <% if (! locals.hiddenLabel || locals.hasInlineLabel || hasLabelSlots) { %>
    <div class="nv-fo-field-label-col<% if (locals.hasInlineLabel) { %> nv-vertical-align-start<% } %>">
        <%- locals.aboveLabel ?? '' %>
        <div class="nv-fo-field-label-ctn">
            <%- locals.beforeLabel ?? '' %>
            <% if (! locals.hiddenLabel) { %>
            <%# Button groups: the label is a <div> referenced by aria-labelledby, not a <label> %>
            <<%- locals.labelAsDiv ? 'div id="' + id + '-label"' : 'label for="' + id + '"' %> class="nv-fo-field-label">
                <%- labelPrefix %>
                <span class="nv-fo-field-label-content">
                    <%- label %><% if (required) { %><sup class="nv-fo-field-label-required-mark">*</sup><% } %>
                </span>
            </<%- locals.labelAsDiv ? 'div' : 'label' %>>
            <% } %>
            <%# After the label: the afterLabel() slot, or the hint, hint icon and hint actions, inline and right-aligned %>
            <%- locals.afterLabel ?? '' %>
        </div>
        <%- locals.belowLabel ?? '' %>
    </div>
    <% } %>
    <% const below = locals.belowContent ?? ''; %>
    <% if (html !== '' || below !== '' || errorMessage !== null || locals.aboveContent || locals.beforeContent || locals.afterContent) { %>
        <div class="nv-fo-field-content-col">
            <% if (locals.hasAboveContent) { %><div class="nv-fo-field-content-slot"><%- locals.aboveContent %></div><% } %>
            <% if (locals.hasBeforeContent || locals.hasAfterContent) { %>
            <div class="nv-fo-field-content-ctn<% if (! (locals.beforeContent || locals.afterContent)) { %> nv-empty<% } %>">
                <% if (locals.hasBeforeContent) { %><div class="nv-fo-field-content-slot"><%- locals.beforeContent %></div><% } %>
                <div class="nv-fo-field-content"><%- html %></div>
                <%- locals.afterContent ?? '' %>
            </div>
            <% } else { %>
            <%- html %>
            <% } %>
            <%- below %>
            <% if (errorMessage !== null) { %>
                <%- locals.aboveErrorMessage ?? '' %>
                <% if (locals.htmlErrorMessages) { %>
                <div id="<%= id %>-error" data-validation-error class="nv-fo-field-wrp-error-message">
                    <%- errorMessage %>
                </div>
                <% } else { %>
                <p id="<%= id %>-error" data-validation-error class="nv-fo-field-wrp-error-message">
                    <%= errorMessage %>
                </p>
                <% } %>
                <%- locals.belowErrorMessage ?? '' %>
            <% } %>
        </div>
    <% } %>
    <%- locals.after ?? '' %>
</div>
