<%# Grid column wrapper of a schema component: a <fieldset> when the component has a client-side visibility condition. %>
<% const tag = locals.visibilityJs ? 'fieldset' : 'div'; %><<%- tag %><% if (locals.visibilityJs) { %> disabled role="none"<% } %><% if (key !== null) { %> wire:partial="schema-component::<%- key %>"<% } %><% if (isVisible) { %> x-data="<%- alpine %>"<% if (locals.init) { %> x-init="<%- init.replace(/&/g, '&amp;').replace(/"/g, '&quot;') %>"<% } %><% if (locals.visibilityJs) { %> x-bind:class="<%- `{ 'nv-hidden': ! (${visibilityJs}) }`.replace(/&/g, '&amp;').replace(/"/g, '&quot;') %>" x-bind:disabled="<%- `! (${visibilityJs})`.replace(/&/g, '&amp;').replace(/"/g, '&quot;') %>" x-cloak<% } %><% } %> <%- attributes %>><% if (isVisible) { %><div class="nv-sc-component<% if (locals.gridContainer) { %> nv-grid-ctn<% } %>"><%- html %></div><% } %></<%- tag %>>