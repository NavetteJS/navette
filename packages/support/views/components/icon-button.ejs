<%# Gray icon button without badge.
    `extra`: attributes placed after the loading attributes; with `after` (modal close button), `extra` goes before `type` and `after` comes last. %>
<% const lead = locals.after ? (locals.extra ? extra.toHtml() + ' ' : '') : ''; const tail = locals.after ? after.toHtml() : (locals.extra ? extra.toHtml() : ''); %>
<button class="nv-icon-btn nv-size-<%- locals.size ?? 'md' %> <%- className %>" title="<%= label %>" aria-label="<%= label %>" <%- lead %>type="button" wire:loading.attr="aria-disabled" wire:loading.class="nv-disabled"<% if (tail) { %> <%- tail %><% } %>>
    <%- icon(iconName, { size: locals.iconSize ?? 'md', alias: locals.iconAlias }) %>
</button>
