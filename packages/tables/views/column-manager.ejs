<%# Gestionnaire de colonnes — repris tel quel du HTML servi par Filament 5.11.2 (filament-tables::components.column-manager), généré par tools : identifiant, libellés et classes de couleur substitués.
    Rendu entièrement par Alpine (filamentTableColumnManager) à partir de l'état `tableColumns`. %>
<div
    x-data="filamentDropdown({ isMenu: false })"
    class="fi-dropdown fi-ta-col-manager-dropdown" wire:key="<%= id %>.table.column-manager"
>
    <div
        x-on:mousedown="if ($event.button === 0) toggle($event)"
        class="fi-dropdown-trigger"
    >
        <button                                                title="<%= t('filament-tables::table.actions.column_manager.label') %>" aria-label="<%= t('filament-tables::table.actions.column_manager.label') %>" type="button" wire:loading.attr="aria-disabled" wire:loading.class="fi-disabled" class="fi-force-enabled fi-ac-icon-btn-action fi-icon-btn fi-size-md"        >
            <svg class="fi-icon fi-size-md" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon">
  <path d="M14 17h2.75A2.25 2.25 0 0 0 19 14.75v-9.5A2.25 2.25 0 0 0 16.75 3H14v14ZM12.5 3h-5v14h5V3ZM3.25 3H6v14H3.25A2.25 2.25 0 0 1 1 14.75v-9.5A2.25 2.25 0 0 1 3.25 3Z"/>
</svg>            
                    </button>
    </div>
            <div
            x-cloak
            x-float.placement.bottom-end.shift.offset="{ offset: 8,  }"
            x-ref="panel"
            x-transition:enter-start="fi-opacity-0"
            x-transition:leave-end="fi-opacity-0"
                                        wire:ignore.self
                wire:key="<%= id %>.table.column-manager.panel"
                        class="fi-dropdown-panel fi-width-xs"
            style=""
        >
            <div
    x-data="filamentTableColumnManager({
                columns: $wire.entangle('tableColumns'),
                isLive: false,
            })"
    class="fi-ta-col-manager"
>
    <div class="fi-ta-col-manager-header">
        <h2 class="fi-ta-col-manager-heading"><%= t('filament-tables::table.column_manager.heading') %></h2>
                    <div>
                <button
                class="<%- cls([...dangerLinkClasses, 'fi-link', 'fi-size-md']) %>" type="button" wire:loading.attr="aria-disabled" wire:loading.class="fi-disabled" wire:target="resetTableColumnManager" wire:click="resetTableColumnManager" wire:loading.remove.delay.default="" x-on:click="resetDeferredColumns"
>
                        <svg
        fill="none"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true" wire:loading.delay.default="" wire:target="resetTableColumnManager" class="fi-icon fi-loading-indicator fi-size-md"
    >
        <path
            clip-rule="evenodd"
            d="M12 19C15.866 19 19 15.866 19 12C19 8.13401 15.866 5 12 5C8.13401 5 5 8.13401 5 12C5 15.866 8.13401 19 12 19ZM12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22Z"
            fill-rule="evenodd"
            fill="currentColor"
            opacity="0.2"
        ></path>
        <path
            d="M2 12C2 6.47715 6.47715 2 12 2V5C8.13401 5 5 8.13401 5 12H2Z"
            fill="currentColor"
        ></path>
    </svg>
            <span class="fi-link-label"><%= t('filament-tables::table.column_manager.actions.reset.label') %></span>
    </button>            </div>
            </div>
    <div
        x-id="['fi-ta-col-manager-group-checkbox', 'fi-ta-col-manager-column-checkbox']"
            class="fi-grid fi-grid-direction-col lg:fi-grid-cols  fi-ta-col-manager-items" style="--cols-lg: 1; --cols-default: 1;"
>
    <template
        x-for="column in getVisibleColumns()"
        x-bind:key="JSON.stringify([column.type, column.name])"
    >
        <div
                    >
            <template x-if="column.type === 'group'">
                <div class="fi-ta-col-manager-group">
                    <div class="fi-ta-col-manager-item">
                        <label
                             x-bind:for="$id('fi-ta-col-manager-group-checkbox', column.name)"                             class="fi-ta-col-manager-label"
                        >
                                                            <input
                                    type="checkbox"
                                    class="fi-checkbox-input fi-valid"
                                    x-bind:id="$id('fi-ta-col-manager-group-checkbox', column.name)"
                                    x-bind:checked="(groupedColumns[column.name] || {}).checked || false"
                                    x-bind:disabled="(groupedColumns[column.name] || {}).disabled || false"
                                    x-effect="$el.indeterminate = (groupedColumns[column.name] || {}).indeterminate || false"
                                    x-on:change="toggleGroup(column.name)"
                                />
                            <span x-html="column.label"></span>
                        </label>
                                            </div>
                    <div
                                                class="fi-ta-col-manager-group-items"
                    >
                        <template
                            x-for="groupColumn in getVisibleColumns(column.name)"
                            x-bind:key="JSON.stringify([groupColumn.type, groupColumn.name])"
                        >
                            <div
                                                            >
                                <div class="fi-ta-col-manager-item">
                                    <label
                                         x-bind:for="$id('fi-ta-col-manager-column-checkbox', groupColumn.name)"                                         class="fi-ta-col-manager-label"
                                    >
                                                                                    <input
                                                type="checkbox"
                                                class="fi-checkbox-input fi-valid"
                                                x-bind:id="$id('fi-ta-col-manager-column-checkbox', groupColumn.name)"
                                                x-bind:checked="(getColumn(groupColumn.name, column.name) || {}).isToggled || false"
                                                x-bind:disabled="(getColumn(groupColumn.name, column.name) || {}).isToggleable === false"
                                                x-on:change="toggleColumn(groupColumn.name, column.name)"
                                            />
                                        <span
                                            x-html="groupColumn.label"
                                        ></span>
                                    </label>
                                                                    </div>
                            </div>
                        </template>
                    </div>
                </div>
            </template>
            <template x-if="column.type !== 'group'">
                <div class="fi-ta-col-manager-item">
                    <label
                         x-bind:for="$id('fi-ta-col-manager-column-checkbox', column.name)"                         class="fi-ta-col-manager-label"
                    >
                                                    <input
                                type="checkbox"
                                class="fi-checkbox-input fi-valid"
                                x-bind:id="$id('fi-ta-col-manager-column-checkbox', column.name)"
                                x-bind:checked="(getColumn(column.name, null) || {}).isToggled || false"
                                x-bind:disabled="(getColumn(column.name, null) || {}).isToggleable === false"
                                x-on:change="toggleColumn(column.name)"
                            />
                        <span x-html="column.label"></span>
                    </label>
                                    </div>
            </template>
        </div>
    </template>
    </div>
            <div class="fi-ta-col-manager-actions-ctn">
        <button                                                            type="button" wire:loading.attr="aria-disabled" wire:loading.class="fi-disabled" class="<%- cls(['fi-ac-btn-action', 'fi-btn', 'fi-size-md', ...primaryButtonClasses]) %>" x-on:click="applyTableColumnManager"        ><%= t('filament-tables::table.column_manager.actions.apply.label') %></button>
                    </div>
    </div>
        </div>
    </div>
