<%# Table: header, toolbar, filters, content (rows or layout cards), summaries and pagination. %>
<% const selectPageBinding = `
                                const recordsOnPage = getRecordsOnPage()

                                if (recordsOnPage.length && areRecordsSelected(recordsOnPage)) {
                                    $el.checked = true
                                    $el.indeterminate = false

                                    return 'checked'
                                }

                                $el.checked = false
                                $el.indeterminate =
                                    recordsOnPage.length && areRecordsPartiallySelected(recordsOnPage)

                                return null
                            ` %>
<% const rowActionsCell = (row) => { %>
                                <td class="nv-ta-cell">
                                    <div class="<%- cls(['nv-ta-actions', actionsAlignment ? 'nv-align-' + actionsAlignment : '']) %>">
                                        <%- row.actionsHtml ?? '' %>
                                        <% for (const action of row.actions) { %>
                                            <a href="<%= action.url %>" wire:navigate wire:key="<%= id %>.actions.<%= action.key %>" class="<%- cls(['nv-ac-link-action', 'nv-link', 'nv-size-sm', ...linkClasses]) %>">
                                                <%- icon(action.icon, { size: 'sm' }) %>
                                                <span class="nv-link-label">
                                                    <%= action.label %>
                                                </span>
                                            </a>
                                        <% } %>
                                    </div>
                                </td>
<% }; %>
<%
    // Filters trigger button (funnel icon and active filter count) and filters panel, shared by every filters layout.
    const filtersTriggerDefault = () => `<button title="${e(t('navette-tables::table.actions.filter.label'))}" aria-label="${e(t('navette-tables::table.actions.filter.label'))}" type="button" wire:loading.attr="aria-disabled" wire:loading.class="nv-disabled" class="nv-force-enabled nv-ac-icon-btn-action nv-icon-btn nv-size-md">${icon('m-funnel', { alias: 'tables::actions.filter' })}<div class="nv-icon-btn-badge-ctn"><span class="${cls([...badgeClasses, 'nv-badge', 'nv-size-xs'])}">${activeFiltersCount}</span></div></button>`;
    const filtersTrigger = () => filterActions.trigger.customized
        ? filterActionHtml(filterActions.trigger, 'type="button" wire:loading.attr="aria-disabled" wire:loading.class="nv-disabled"', `<span class="${cls([...badgeClasses, 'nv-badge', 'nv-size-xs'])}">${activeFiltersCount}</span>`)
        : filtersTriggerDefault();
    const filterButton = (action, colorClasses, label, extra = '') => `<button type="button" wire:loading.attr="aria-disabled" wire:loading.class="nv-disabled" class="${cls(['nv-ac-btn-action', 'nv-btn', 'nv-size-md', ...colorClasses])}" data-table-filter-action="${action}" wire:click="${action === 'apply' ? 'applyTableFilters' : 'resetTableFiltersForm'}"${extra}>${e(label)}</button>`;
    // Modal layout: "Apply" (deferred filters) closes the modal; "Reset" stays in the footer.
    const filtersModalFooter = (modalId) => [
        ...(filtersDeferred && !filterActions.apply.hidden ? [filterButton('apply', primaryButtonClasses, filterActions.apply.label, ` x-on:click="${e("$dispatch('close-modal', { id: " + js(modalId) + ' })')}"`)] : []),
        ...(filterActions.reset.hidden ? [] : [filterButton('reset', grayButtonClasses, filterActions.reset.label)]),
    ];
    const filtersPanel = (classes, extra = {}, closeModal = null) => view('navette-tables::filters', { attributes: attrs(extra).class(['nv-ta-filters', ...classes]).toHtml(), form: filtersForm, deferred: filtersDeferred, resetPosition: filtersResetPosition, closeModal, dangerLinkClasses, primaryButtonClasses, grayButtonClasses, filterActions, filterActionHtml });
%>
<div x-data="navetteTable({
                areGroupsCollapsedByDefault: <%- grouping.collapsedByDefault ? 'true' : 'false' %>,
                canTrackDeselectedRecords: <%- canTrackDeselectedRecords ? 'true' : 'false' %>,
                currentSelectionLivewireProperty: <%- selection ? js(selection.property) : 'null' %>,
                maxSelectableRecords: <%- maxSelectableRecords ?? 'null' %>,
                reorderMessage: <%- js(t('navette-tables::table.reordering.moved')) %>,
                selectsCurrentPageOnly: <%- selectsCurrentPageOnly ? 'true' : 'false' %>,
            })"<% if (!isLoaded) { %> wire:init="loadTable"<% } %> class="<%- cls(['nv-ta', { 'nv-loading': !isLoaded }]) %>">
    <input type="hidden" value="<%- allCount %>" x-ref="allSelectableRecordsCount" />

    <% if (reorder) { %><span wire:ignore x-ref="tableReorderStatus" role="status" aria-live="polite" aria-atomic="true" class="nv-sr-only"></span><% } %>

    <div class="nv-ta-ctn<%- contentLayout ? ' nv-ta-ctn-with-content-layout' : '' %> nv-ta-ctn-with-footer nv-ta-ctn-with-header">
        <% if (filtersForm !== null && filtersLayout.startsWith('before-content')) { %>
        <div wire:ignore.self x-ref="filtersContentContainer" x-transition:enter-start="nv-opacity-0" x-transition:leave-end="nv-opacity-0" x-bind:class="{ 'nv-open': areFiltersOpen }" class="<%- cls(['nv-ta-filters-before-content-ctn', { 'lg:nv-open': !filtersLayout.endsWith('-collapsible') }, 'nv-width-' + (filtersFormWidth ?? 'xs')]) %>">
            <%- filtersPanel(['nv-ta-filters-before-content']) %>
        </div>
        <% } %>
        <div class="nv-ta-main">
            <%# The toolbar is always visible only when it has content (search, filters, columns); otherwise only while records are selected. %>
            <%
                const hasFilters = filtersForm !== null;
                const filtersDialog = hasFilters && (filtersLayout === 'dropdown' || filtersLayout === 'modal');
                const filtersAbove = hasFilters && (filtersLayout === 'above-content' || filtersLayout === 'above-content-collapsible');
                const filtersBelow = hasFilters && filtersLayout === 'below-content';
                const filtersBefore = hasFilters && filtersLayout.startsWith('before-content');
                const filtersAfter = hasFilters && filtersLayout.startsWith('after-content');
                const filtersCollapsible = hasFilters && filtersLayout.endsWith('-collapsible');
                const filtersTriggerInToolbar = filtersDialog || filtersBefore || filtersAfter;
                const filtersModalId = id + '-table-filters';
            %>
            <% const toolbarVisible = reorder !== null || groups.length > 0 || isSearchable || filtersTriggerInToolbar || hasColumnManager || toolbarActions.length > 0; %>
            <div x-show="<%- header || heading !== null || description || headerActions.length || toolbarVisible ? 'true' : 'false' %> || false || (getSelectedRecordsCount() && <%- bulkActions.length || (selectable && !selection) ? 1 : 0 %>)" wire:key="<%= id %>.table.header.visible" class="nv-ta-header-ctn">
                <%- hook('tables::header.before') %>
                <% if (header) { %>
                    <%- header %>
                <% } else if (heading !== null || description || headerActions.length) { %>
                    <div class="<%- cls(['nv-ta-header', { 'nv-ta-header-adaptive-actions-position': headerActions.length }]) %>">
                        <% if (heading !== null || description) { %>
                            <% if (headingIcon) { %><div class="nv-ta-header-heading-ctn"><%- headingIcon %><% } %>
                            <div>
                                <% if (heading !== null) { %>
                                <h2 class="nv-ta-header-heading">
                                    <%= heading %>
                                </h2>
                                <% } %>
                                <% if (description) { %>
                                <p class="nv-ta-header-description">
                                    <%= description %>
                                </p>
                                <% } %>
                            </div>
                            <% if (headingIcon) { %></div><% } %>
                        <% } %>
                        <% if (headerActions.length) { %>
                            <div class="nv-ta-actions nv-align-start nv-wrapped">
                                <%- headerActions.join('') %>
                            </div>
                        <% } %>
                    </div>
                <% } %>
                <%- hook('tables::header.after') %>
                <% if (filtersAbove) { %>
                    <%# Filters above the content, optionally collapsible. %>
                    <div<% if (filtersCollapsible) { %> x-bind:class="{ 'nv-open': areFiltersOpen }"<% } %> class="nv-ta-filters-above-content-ctn">
                        <%- filtersPanel([], filtersCollapsible ? { 'x-cloak': 'x-cloak', 'x-show': 'areFiltersOpen' } : { 'x-cloak': 'x-cloak' }) %>
                        <% if (filtersCollapsible) { %>

                        <span x-on:click="areFiltersOpen = ! areFiltersOpen" class="nv-ta-filters-trigger-action-ctn">
                            <%- filtersTrigger() %>
                        </span>
                        <% } %>
                    </div>
                <% } %>
                <%- hook('tables::toolbar.before') %>
                <div<% if (!toolbarVisible) { %> x-cloak<% } %> x-show="<%- toolbarVisible ? 'true' : 'false' %> || false || (getSelectedRecordsCount() && <%- bulkActions.length || (selectable && !selection) ? 1 : 0 %>)" wire:key="<%= id %>.table.header-toolbar.<%- toolbarVisible ? 'visible' : 'selection' %>" class="nv-ta-header-toolbar">
                    <%- hook('tables::toolbar.start') %>
                    <div class="nv-ta-actions nv-align-start nv-wrapped">
                        <%- hook('tables::toolbar.reorder-trigger.before') %>
                        <% if (reorder && reorder.trigger.customized) { %>
                            <% if (!reorder.trigger.hidden) { %><%- filterActionHtml(reorder.trigger, 'type="button" wire:loading.attr="aria-disabled" wire:loading.class="nv-disabled" wire:click="toggleTableReordering"', null, true) %><% } %>
                        <% } else if (reorder) { %>
                            <% const reorderLabel = t(reorder.active ? 'navette-tables::table.actions.disable_reordering.label' : 'navette-tables::table.actions.enable_reordering.label') %>
                            <button title="<%= reorderLabel %>" aria-label="<%= reorderLabel %>" type="button" wire:loading.attr="aria-disabled" wire:loading.class="nv-disabled" wire:click="toggleTableReordering" class="nv-force-enabled nv-ac-icon-btn-action nv-icon-btn nv-size-md">
                                <%- icon(reorder.active ? 'm-check' : 'm-arrows-up-down', { alias: reorder.active ? 'tables::actions.disable-reordering' : 'tables::actions.enable-reordering', attributes: attrs({ 'wire:loading.remove.delay.default': '1', 'wire:target': 'toggleTableReordering' }) }) %>
                                <%- loadingIndicator(attrs({ 'wire:loading.delay.default': '', 'wire:target': 'toggleTableReordering' })) %>
                            </button>
                        <% } %>
                        <%- hook('tables::toolbar.reorder-trigger.after') %>
                        <%- toolbarActions.join('') %>
                        <% for (const menu of bulkMenus) { %>
                            <% const menuTooltip = menu.tooltip ? ' x-tooltip="' + e('{ content: ' + js(menu.tooltip) + ', theme: $store.theme, allowHTML: false }') + '"' : ''; %>
                            <div x-data="navetteDropdown" x-cloak="x-cloak" x-show="getSelectedRecordsCount()" class="nv-dropdown">
                                <div x-on:mousedown="if ($event.button === 0) toggle($event)" class="nv-dropdown-trigger">
                                    <button title="<%= menu.label %>"<%- menuTooltip %> type="button" wire:loading.attr="aria-disabled" wire:loading.class="nv-disabled" class="<%- cls(['nv-ac-btn-group', 'nv-icon-btn', 'nv-size-md', ...bulkMenuColors('icon-button', menu.color)]) %>">
                                        <%- menu.customized ? icon(menu.icon) : icon('m-ellipsis-vertical', { alias: 'tables::actions.open-bulk-actions' }) %>
                                    </button>
                                    <button<%- menuTooltip %> type="button" wire:loading.attr="aria-disabled" wire:loading.class="nv-disabled" class="<%- cls(['nv-ac-btn-group', 'nv-btn', 'nv-size-md', 'nv-labeled-from-sm', ...bulkMenuColors('button', menu.color)]) %>">
                                        <%- menu.customized ? icon(menu.icon) : icon('m-ellipsis-vertical', { alias: 'tables::actions.open-bulk-actions' }) %>
                                        <%= menu.label %>
                                    </button>
                                </div>

                                <div x-cloak x-float.placement.<%- menu.placement %>.flip.offset="{ offset: 8 }" x-ref="panel" x-transition:enter-start="nv-opacity-0" x-transition:leave-end="nv-opacity-0" role="menu" class="nv-dropdown-panel">
                                    <div class="nv-dropdown-list" role="group">
                                        <%- menu.actions.join('') %>
                                    </div>
                                </div>
                            </div>
                        <% } %>
                        <%- hook('tables::toolbar.grouping-selector.before') %>
                        <% if (groups.length) { %>
                            <% const groupLabel = t('navette-tables::table.grouping.fields.group.label'); const directionLabel = t('navette-tables::table.grouping.fields.direction.label'); %>
                            <div x-data="{
                                    grouping: $wire.$entangle('tableGrouping', true),
                                    group: null,
                                    direction: null,
                                }" x-init="
                                    if (grouping) {
                                        ;[group, direction] = grouping.split(':')
                                        direction ??= 'asc'
                                    }

                                    $watch('grouping', function () {
                                        if (! grouping) {
                                            group = null
                                            direction = null

                                            return
                                        }

                                        ;[group, direction] = grouping.split(':')
                                        direction ??= 'asc'
                                    })

                                    $watch('direction', function () {
                                        grouping = group ? `${group}:${direction}` : null
                                    })

                                    $watch('group', function (newGroup, oldGroup) {
                                        if (! newGroup) {
                                            direction = null
                                            grouping = group ? `${group}:${direction}` : null

                                            return
                                        }

                                        if (oldGroup) {
                                            grouping = group ? `${group}:${direction}` : null

                                            return
                                        }

                                        direction ??= 'asc'
                                        grouping = group ? `${group}:${direction}` : null
                                    })
                                " class="nv-ta-grouping-settings">
                                <div x-data="navetteDropdown({ isMenu: false })" class="<%- cls(['nv-dropdown', { 'sm:nv-hidden': !grouping.inDropdownOnDesktop }]) %>" wire:key="<%= id %>.table.grouping">
                                    <div x-on:mousedown="if ($event.button === 0) toggle($event)" class="nv-dropdown-trigger">
                                        <% if (grouping.trigger.customized) { %><% if (!grouping.trigger.hidden) { %><%- filterActionHtml(grouping.trigger, 'type="button" wire:loading.attr="aria-disabled" wire:loading.class="nv-disabled"', null, true) %><% } %><% } else { %>
                                        <button title="<%= t('navette-tables::table.actions.group.label') %>" aria-label="<%= t('navette-tables::table.actions.group.label') %>" type="button" wire:loading.attr="aria-disabled" wire:loading.class="nv-disabled" class="nv-force-enabled nv-ac-icon-btn-action nv-icon-btn nv-size-md">
                                            <%- icon('m-rectangle-stack', { alias: 'tables::actions.group' }) %>
                                        </button>
                                        <% } %>
                                    </div>
                                    <div x-cloak x-float.placement.bottom-start.flip.shift.offset="{ offset: 8, }" x-ref="panel" x-transition:enter-start="nv-opacity-0" x-transition:leave-end="nv-opacity-0" wire:ignore.self wire:key="<%= id %>.table.grouping.panel" class="nv-dropdown-panel nv-width-xs" style="">
                                        <div class="nv-ta-grouping-settings-fields">
                                            <label>
                                                <span><%= groupLabel %></span>
                                                <div class="nv-input-wrp"><div class="nv-input-wrp-content-ctn"><select class="nv-select-input" x-model="group" x-on:change="resetCollapsedGroups()"><option value="">-</option><% for (const option of groups) { %><option value="<%= option.id %>"><%= option.label %></option><% } %></select></div></div>
                                            </label>
                                            <% if (!grouping.directionHidden) { %>
                                            <label x-cloak x-show="group">
                                                <span><%= directionLabel %></span>
                                                <div class="nv-input-wrp"><div class="nv-input-wrp-content-ctn"><select class="nv-select-input" x-model="direction"><option value="asc"><%= t('navette-tables::table.grouping.fields.direction.options.asc') %></option><option value="desc"><%= t('navette-tables::table.grouping.fields.direction.options.desc') %></option></select></div></div>
                                            </label>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>
                                <% if (!grouping.inDropdownOnDesktop) { %>
                                <div class="nv-ta-grouping-settings-fields">
                                    <label>
                                        <div class="nv-input-wrp"><div x-on:click="if (! $event.target.closest('.nv-input-wrp-actions')) $dispatch('focus-input')" class="nv-input-wrp-prefix nv-input-wrp-prefix-has-content nv-input-wrp-prefix-has-label"><span class="nv-input-wrp-label"><%= groupLabel %></span></div><div class="nv-input-wrp-content-ctn"><select class="nv-select-input" x-model="group" x-on:change="resetCollapsedGroups()"><option value="">-</option><% for (const option of groups) { %><option value="<%= option.id %>"><%= option.label %></option><% } %></select></div></div>
                                    </label>
                                    <% if (!grouping.directionHidden) { %>
                                    <label x-cloak x-show="group">
                                        <span class="nv-sr-only"><%= directionLabel %></span>
                                        <div class="nv-input-wrp"><div class="nv-input-wrp-content-ctn"><select class="nv-select-input" x-model="direction"><option value="asc"><%= t('navette-tables::table.grouping.fields.direction.options.asc') %></option><option value="desc"><%= t('navette-tables::table.grouping.fields.direction.options.desc') %></option></select></div></div>
                                    </label>
                                    <% } %>
                                </div>
                                <% } %>
                            </div>
                        <% } %>
                        <%- hook('tables::toolbar.grouping-selector.after') %>
                    </div>

                    <% if (toolbarVisible) { %><div>
                        <%- hook('tables::toolbar.search.before') %>
                        <% if (isSearchable) { %><div x-id="['input']" class="nv-ta-search-field">
                            <label x-bind:for="$id('input')" class="nv-sr-only">
                                <%= t('navette-tables::table.fields.search.label') %>
                            </label>

                            <div class="nv-input-wrp">
                                <div x-on:click="if (! $event.target.closest('.nv-input-wrp-actions')) $dispatch('focus-input')" class="nv-input-wrp-prefix nv-input-wrp-prefix-has-content nv-inline">
                                    <%- icon('m-magnifying-glass', { alias: 'tables::search-field', attributes: attrs({ 'wire:loading.remove.delay.default': '1', 'wire:target': 'tableSearch' }) }) %>
                                    <%- loadingIndicator(attrs({ 'wire:loading.delay.default': '', 'wire:target': 'tableSearch' })) %>
                                </div>

                                <div class="nv-input-wrp-content-ctn">
                                    <input class="nv-input nv-input-has-inline-prefix" autocomplete="off" maxlength="1000" placeholder="<%= search.placeholder %>" type="search" wire:key="<%= id %>.table.tableSearch.field.input" <%- search.model %>="tableSearch" x-bind:id="$id('input')" x-on:keyup="if ($event.key === 'Enter') { $wire.$refresh() }" />
                                </div>
                            </div>
                        </div><% } %>
                        <%- hook('tables::toolbar.search.after') %>

                        <% if (filtersDialog && filtersLayout === 'modal') { %>
                            <div class="nv-ta-filters-modal-trigger" x-on:click="$dispatch('open-modal', { id: <%= js(filtersModalId) %> })">
                                <%- filtersTrigger() %>
                            </div>
                            <%- modal({ id: filtersModalId, heading: t('navette-tables::table.filters.heading'), width: filtersFormWidth ?? 'md', livewireId: id, footerActions: filtersModalFooter(filtersModalId) }, filtersForm) %>
                        <% } else if (filtersDialog) { %>
                            <div x-data="navetteDropdown({ isMenu: false })" class="nv-dropdown nv-ta-filters-dropdown" wire:key="<%= id %>.table.filters">
                                <div x-on:mousedown="if ($event.button === 0) toggle($event)" class="nv-dropdown-trigger">
                                    <%- filtersTrigger() %>
                                </div>

                                <div x-cloak x-float.placement.bottom-end.shift.offset="{ offset: 8,  }" x-ref="panel" x-transition:enter-start="nv-opacity-0" x-transition:leave-end="nv-opacity-0" wire:ignore.self wire:key="<%= id %>.table.filters.panel" class="nv-dropdown-panel nv-width-<%= filtersFormWidth ?? 'xs' %>" style="<%= filtersFormMaxHeight ? 'max-height: ' + filtersFormMaxHeight : '' %>">
                                    <%- filtersPanel([], { 'x-data': 'navetteTableFilters', 'x-on:click': 'handleActionClick($event)', tabindex: '-1' }) %>
                                </div>
                            </div>
                        <% } else if (filtersBefore || filtersAfter) { %>
                            <span x-ref="filtersTriggerActionContainer" x-on:click="toggleFiltersDropdown" class="<%- cls(['nv-ta-filters-trigger-action-ctn', { 'lg:nv-hidden': !filtersCollapsible }]) %>">
                                <%- filtersTrigger() %>
                            </span>
                        <% } %>

                        <%# These two hook slots only exist when there is a filters trigger or a column manager. %>
                        <% if (filtersTriggerInToolbar || hasColumnManager) { %><%- hook('tables::toolbar.toggle-column-trigger.before') %><% } %>
                        <% if (hasColumnManager) { %>
                            <%- view('navette-tables::column-manager', { id, dangerLinkClasses, primaryButtonClasses, dangerButtonClasses: buttonColorClasses('danger'), buttonColorClasses, columnManager, modal, filterActionHtml, heading }) %>
                        <% } %>
                        <% if (filtersTriggerInToolbar || hasColumnManager) { %><%- hook('tables::toolbar.toggle-column-trigger.after') %><% } %>
                    </div><% } %>
                    <%- hook('tables::toolbar.end') %>
                </div>
                <%- hook('tables::toolbar.after') %>

                </div>

            <% if (reorder?.active) { %>
                <div x-cloak role="status" aria-live="polite" wire:key="<%= id %>.table.reorder.indicator" class="nv-ta-reorder-indicator">
                    <%- loadingIndicator(attrs({ 'wire:loading.delay.default': '', 'wire:target': 'reorderTable,moveTableRecord' })) %>
                    <%= t('navette-tables::table.reorder_indicator') %>
                </div>
            <% } %>
            <% if (selection ? maxSelectableRecords !== 1 : selectable) { %>
                    <div x-cloak role="status" aria-live="polite" aria-atomic="true" x-bind:hidden="! getSelectedRecordsCount()" x-show="getSelectedRecordsCount()" wire:key="<%= id %>.table.selection.indicator" class="nv-ta-selection-indicator">
                        <div>
                            <%- loadingIndicator(attrs({ 'x-show': 'isLoading' })) %>

                            <span x-text="
                                    window.pluralize(<%= js(t('navette-tables::table.selection_indicator.selected_count')) %>, getSelectedRecordsCount(), {
                                        count: new Intl.NumberFormat(<%= js('en') %>).format(getSelectedRecordsCount()),
                                    })
                                "></span>
                        </div>

                        <div>
                            <%- hook('tables::selection.indicator.actions.before') %>
                            <div class="nv-ta-selection-indicator-actions-ctn">
                                <% if (!selectsGroupsOnly) { %><button class="<%- cls([...linkClasses, 'nv-link', 'nv-size-md']) %>" type="button" wire:loading.attr="aria-disabled" wire:loading.class="nv-disabled" x-on:click="selectAllRecords" x-show="canSelectAllRecords()" wire:key="<%= id %>table.selection.indicator.actions.select-all.<%- allCount %>.<%- page.page %>">
                                    <span class="nv-link-label">
                                        <%= t('navette-tables::table.selection_indicator.actions.select_all.label', { count: number(allCount) }) %>
                                    </span>
                                </button><% } %>
                                <button class="<%- cls([...dangerLinkClasses, 'nv-link', 'nv-size-md']) %>" type="button" wire:loading.attr="aria-disabled" wire:loading.class="nv-disabled" x-on:click="deselectAllRecords">
                                    <span class="nv-link-label">
                                        <%= t('navette-tables::table.selection_indicator.actions.deselect_all.label') %>
                                    </span>
                                </button>
                            </div>
                            <%- hook('tables::selection.indicator.actions.after') %>
                        </div>
                    </div>
                <% } %>

            <%# A `tables::filter.indicators` hook that renders something replaces the default indicators. %>
            <% const filterIndicatorsView = filterIndicators.length ? hook('tables::filter.indicators', { filterIndicators }) : ''; %>
            <% if (filterIndicatorsView.trim() !== '') { %><%- filterIndicatorsView %><% } else if (filterIndicators.length) { %>
                <%# Active filter indicators. %>
                <div class="nv-ta-filter-indicators">
                    <div>
                        <span class="nv-ta-filter-indicators-label">
                            <%= t('navette-tables::table.filters.indicator') %>
                        </span>

                        <div class="nv-ta-filter-indicators-badges-ctn" role="list">
                            <% for (const indicator of filterIndicators) { %>
                                <% const removal = 'removeTableFilter(' + js(indicator.filter) + ', ' + js(indicator.field) + ')'; %>
                                <span class="<%- cls([...(indicator.color ? indicatorColorClasses(indicator.color) : indicatorBadgeClasses), 'nv-badge', 'nv-size-md']) %>" role="listitem">
                                    <span class="nv-badge-label-ctn">
                                        <span class="nv-badge-label">
                                            <%= indicator.label %>
                                        </span>
                                    </span>

                                    <% if (indicator.removable) { %>
                                    <button data-prevent-disabled-clicks type="button" class="nv-badge-delete-btn" wire:loading.attr="aria-disabled" wire:loading.class="nv-disabled" wire:target="removeTableFilter" wire:click="<%= removal %>">
                                        <span aria-hidden="true" wire:loading.remove.delay.default="" wire:target="<%= removal %>" class="nv-badge-delete-btn-icon"></span>
                                        <%- loadingIndicator(attrs({ 'wire:loading.delay.default': '', 'wire:target': removal }), 'xs') %>
                                        <span class="nv-sr-only">
                                            <%= t('navette-tables::table.filters.actions.remove.label') %>
                                        </span>
                                    </button>
                                    <% } %>
                                </span>
                            <% } %>
                        </div>
                    </div>

                    <% if (filterIndicators.some((indicator) => indicator.removable) && filterActions.removeAll.customized) { %><% if (!filterActions.removeAll.hidden) { %><%- filterActionHtml(filterActions.removeAll, 'type="button" wire:loading.attr="aria-disabled" wire:loading.class="nv-disabled" wire:target="removeTableFilters,removeTableFilter" wire:click="removeTableFilters"', null, false, 'sm') %><% } %>
                    <% } else if (filterIndicators.some((indicator) => indicator.removable)) { %>
                    <button x-tooltip="{
