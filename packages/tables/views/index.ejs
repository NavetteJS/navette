                                <% if (!reorder?.active && selectable) { %>
                                <td class="nv-ta-cell nv-ta-selection-cell">
                                    <% if (row.selectable) { %><input aria-label="<%= t('navette-tables::table.fields.bulk_select_record.label', { key: row.key }) %>" type="checkbox"<% if (selection?.disabled) { %> disabled<% } else if (maxSelectableRecords && maxSelectableRecords !== 1) { %> x-bind:disabled="! areRecordsToggleable([<%= js(row.key) %>])"<% } %> value="<%= row.key %>" x-on:click="toggleSelectedRecord(<%= js(row.key) %>)" x-bind:checked="isRecordSelected(<%= js(row.key) %>) ? 'checked' : null" data-group="<%= row.groupKey ?? '' %>" wire:loading.attr="disabled" wire:target="<%- targets %>" class="nv-ta-record-checkbox nv-checkbox-input" /><% } %>
                                </td>
                                <% } %><%# end selection cell %>
                                <% if (!reorder?.active && hasRowActions && actionsPosition === 'before-columns') { %><% rowActionsCell(row) %><% } %>

                                <% for (const cell of row.cells) { %>
                                    <td wire:key="<%= id %>.table.record.<%= row.key %>.column.<%= cell.name %>" <%- cell.attributes %> class="<%- cls(['nv-ta-cell', 'nv-ta-cell-' + cell.cssName, cell.alignment && cell.alignment !== 'start' ? 'nv-align-' + cell.alignment : null, ...cell.classes, ...cell.responsive]) %>"<% if (cell.style) { %> style="<%= cell.style %>"<% } %>>
                                        <% if (cell.mountExpression && !cell.url) { %>
                                            <% if (table.isStackedOnMobile()) { %><div class="nv-ta-cell-label"><%= cell.label %></div><div class="nv-ta-cell-content"><% } %>
                                            <button type="button" wire:click.prevent.stop="<%= cell.mountExpression %>" wire:loading.attr="disabled" wire:target="<%= cell.mountExpression %>" class="nv-ta-col">
                                                <%- cell.html %>
                                            </button>
                                            <% if (table.isStackedOnMobile()) { %></div><% } %>
                                        <% } else if (cell.url) { %>
                                            <% if (table.isStackedOnMobile()) { %><div class="nv-ta-cell-label"><%= cell.label %></div><div class="nv-ta-cell-content"><% } %>
                                            <a href="<%= cell.url %>"<% if (cell.urlInNewTab) { %> target="_blank"<% } else if (cell.urlSpa) { %> x-on:click="if (! ($event.altKey || $event.ctrlKey || $event.metaKey || $event.shiftKey)) { $event.preventDefault(); Alpine.navigate($el.getAttribute('href')) }"<% } %> class="nv-ta-col nv-ta-col-has-column-url">
                                                <%- cell.html %>
                                            </a>
                                            <% if (table.isStackedOnMobile()) { %></div><% } %>
                                        <% } else if (row.mountExpression && !cell.plain) { %>
                                            <% if (table.isStackedOnMobile()) { %><div class="nv-ta-cell-label"><%= cell.label %></div><div class="nv-ta-cell-content"><% } %>
                                            <button type="button" wire:click.prevent.stop="<%= row.mountExpression %>" wire:loading.attr="disabled" wire:target="<%= row.mountExpression %>" class="nv-ta-col">
                                                <%- cell.html %>
                                            </button>
                                            <% if (table.isStackedOnMobile()) { %></div><% } %>
                                        <% } else { %>
                                        <%# The content wrapper only exists in stacked mode. %>
                                        <% if (table.isStackedOnMobile()) { %><div class="nv-ta-cell-label"><%= cell.label %></div><div class="nv-ta-cell-content"><% } %>
                                            <% if (row.url && !cell.plain) { %>
                                                <a href="<%= row.url %>"<%- recordLinkAttributes(row.newTab, row.spa) %> class="nv-ta-col">
                                                    <%- cell.html %>
                                                </a>
                                            <% } else { %>
                                                <div class="nv-ta-col"><%- cell.html %></div>
                                            <% } %>
                                        <% if (table.isStackedOnMobile()) { %></div><% } %>
                                        <% } %>
                                    </td>
                                <% } %>

                                <% if (!reorder?.active && hasRowActions && !actionsPosition.startsWith('before')) { %><% rowActionsCell(row) %><% } %><%# end actions cell %>
                            </tr>
                        <% } %>
                        <%# Summaries (already rendered and escaped rows): the last group's, then the table's. %>
                        <%- trailingGroupSummary %>
                        <%- summaryHtml %>
                    </tbody>
                    <% } %>
                </table>
                <% } %><%# end table / cards %>
            </div>

            <%- hook('tables::content.after', { table, records: page.records }) %>
            <% if (rows.length) { %>
                <%- pagination %>
            <% } else if (isLoaded) { %>
<% if (emptyState.custom !== null) { %>
                <%- emptyState.custom %>
                <% } else { %>
                <div class="nv-ta-empty-state" role="status">
                    <div class="nv-ta-empty-state-content">
                        <div class="nv-ta-empty-state-icon-bg">
                            <%- icon(emptyState.icon, { size: 'lg', attributes: attrs({ 'wire:loading.remove.delay.default': '', 'wire:target': targets }) }) %>
                            <%- loadingIndicator(attrs({ 'wire:loading.delay.default': '', 'wire:target': targets }), 'lg') %>
                        </div>

                        <h2 class="nv-ta-empty-state-heading">
                            <%= emptyState.heading %>
                        </h2>
                        <% if (emptyState.description) { %>
                        <p class="nv-ta-empty-state-description">
                            <%= emptyState.description %>
                        </p>
                        <% } %>
                        <% if (emptyState.actions.length) { %>
                        <div class="nv-ta-actions nv-align-center nv-wrapped">
                            <%- emptyState.actions.join('') %>
                        </div>
                        <% } %>
                    </div>
                </div>
                <% } %>
            <% } %>
            <% if (filtersForm !== null && filtersLayout === 'below-content') { %>
            <%- filtersPanel(['nv-ta-filters-below-content']) %>
            <% } %>
        </div>
        <% if (filtersForm !== null && filtersLayout.startsWith('after-content')) { %>
        <div wire:ignore.self x-ref="filtersContentContainer" x-transition:enter-start="nv-opacity-0" x-transition:leave-end="nv-opacity-0" x-bind:class="{ 'nv-open': areFiltersOpen }" class="<%- cls(['nv-ta-filters-after-content-ctn', { 'lg:nv-open': !filtersLayout.endsWith('-collapsible') }, 'nv-width-' + (filtersFormWidth ?? 'xs')]) %>">
            <%- filtersPanel(['nv-ta-filters-after-content']) %>
        </div>
        <% } %>
    </div>
    <%- afterContainer %>
</div>
