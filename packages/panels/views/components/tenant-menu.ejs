<%# Tenant menu; with many tenants (or `searchableTenantMenu()`), a search field filters them and the dropdown is not a menu. Tenant names may be HTML (`HtmlString`). %>
<%- renderHook('panels::tenant-menu.before') %>
<div x-data="navetteDropdown({ isMenu: <%= locals.isSearchable ? 'false' : 'true' %> })" class="nv-dropdown nv-tenant-menu" ><div x-on:mousedown="if ($event.button === 0) toggle($event)" class="nv-dropdown-trigger" ><button<% if (isSidebarCollapsibleOnDesktop) { %> x-data="{ tooltip: false }" x-effect="
                    tooltip = $store.sidebar.isOpen
                        ? false
                        : {
                              content: <%= js(tenant.isHtmlName ? tenant.nameHtml : tenant.name) %>,
                              allowHTML: <%= tenant.isHtmlName ? 'true' : 'false' %>,
                              placement: document.dir === 'rtl' ? 'left' : 'right',
                              theme: $store.theme,
                          }
                " x-tooltip="tooltip"<% } %> type="button" class="nv-tenant-menu-trigger" ><img alt="<%= t('navette-panels::layout.avatar.alt', { name: tenant.name }) %>" class="nv-avatar nv-size-md nv-tenant-avatar" src="<%= tenant.avatarUrl %>" loading="lazy" /><span<% if (isSidebarCollapsibleOnDesktop) { %> x-show="$store.sidebar.isOpen"<% } %> class="nv-tenant-menu-trigger-text" ><% if (tenant.label) { %><span class="nv-tenant-menu-trigger-current-tenant-label"> <%= tenant.label %> </span><% } %><span class="nv-tenant-menu-trigger-tenant-name"> <%- tenant.nameHtml %> </span></span><%- icon('m-chevron-down', isSidebarCollapsibleOnDesktop ? { alias: 'panels::tenant-menu.toggle-button', attributes: attrs({ 'x-show': '$store.sidebar.isOpen' }) } : {}) %></button></div><div x-cloak x-float.placement.bottom-start.size.flip<% if (teleport) { %>.teleport<% } %>.offset="{ offset: 8, size: {&quot;padding&quot;:16} }" x-ref="panel" x-transition:enter-start="nv-opacity-0" x-transition:leave-end="nv-opacity-0"<% if (!locals.isSearchable) { %> role="menu"<% } %> class="nv-dropdown-panel nv-scrollable" style="" ><% for (const list of listsBefore) { %><div class="nv-dropdown-list"><%- list.join('') %></div><% } %><% if (switchable.length) { %><div x-data="navetteTenantMenu"><div class="nv-dropdown-list"><% if (locals.isSearchable) { %><div x-id="['input']"><label x-bind:for="$id('input')" class="nv-sr-only"><%= t('navette-panels::layout.tenant_menu.search_field.label') %></label><input x-bind:id="$id('input')" x-model="search" placeholder="<%= t('navette-panels::layout.tenant_menu.search_field.placeholder') %>" type="search" class="nv-input" /></div><% } %><% for (const other of switchable) { %><div class="nv-tenant-menu-item" x-show="matchesSearch(<%= js(other.name) %>)"><a href="<%= other.url %>" class="nv-dropdown-list-item"<% if (!locals.isSearchable) { %> role="menuitem" tabindex="-1"<% } %>><div class="nv-dropdown-list-item-image" style="background-image: url('<%= other.avatarUrl %>')"></div><span class="nv-dropdown-list-item-label"><%- other.nameHtml %></span></a></div><% } %></div></div><% } %><% for (const list of listsAfter) { %><div class="nv-dropdown-list"><%- list.join('') %></div><% } %></div></div>
<%- renderHook('panels::tenant-menu.after') %>
