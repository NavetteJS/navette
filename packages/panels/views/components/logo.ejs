<%# Logo ou nom de marque — port de filament-panels::components.logo %>
<% if (brand.logo) { %>
    <img alt="<%= t('filament-panels::layout.logo.alt', { name: brand.name }) %>" src="<%= brand.logo %>" style="height: <%- brand.height %>;" class="<%- brand.darkLogo ? 'fi-logo fi-logo-light' : 'fi-logo' %>" />
    <% if (brand.darkLogo) { %>
        <img alt="<%= t('filament-panels::layout.logo.alt', { name: brand.name }) %>" src="<%= brand.darkLogo %>" style="height: <%- brand.height %>;" class="fi-logo fi-logo-dark" />
    <% } %>
<% } else { %>
    <div class="fi-logo"><%= brand.name %></div>
<% } %>
