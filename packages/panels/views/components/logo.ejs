<%# Brand logo or brand name %>
<% if (brand.logo) { %>
    <img alt="<%= t('navette-panels::layout.logo.alt', { name: brand.name }) %>" src="<%= brand.logo %>" style="height: <%- brand.height %>;" class="<%- brand.darkLogo ? 'nv-logo nv-logo-light' : 'nv-logo' %>" />
    <% if (brand.darkLogo) { %>
        <img alt="<%= t('navette-panels::layout.logo.alt', { name: brand.name }) %>" src="<%= brand.darkLogo %>" style="height: <%- brand.height %>;" class="nv-logo nv-logo-dark" />
    <% } %>
<% } else { %>
    <div class="nv-logo"><%= brand.name %></div>
<% } %>
