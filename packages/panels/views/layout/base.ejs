<%# Panel HTML document %>
<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>" class="nv">
    <head>
        <%- renderHook('panels::head.start', renderHookScopes) %>
        <meta charset="utf-8" />
        <meta name="csrf-token" content="<%- csrf %>" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />

        <% if (locals.favicon) { %><link rel="icon" href="<%= favicon %>" /><% } %>

        <title>
            <%= title %>
             -
            <%= brandName %>
        </title>

        <%- renderHook('panels::styles.before', renderHookScopes) %>
        <style<%- cspNonceAttribute() %>>
            [x-cloak=''],
            [x-cloak='x-cloak'],
            [x-cloak='1'] {
                display: none !important;
            }

            [x-cloak='inline-flex'] {
                display: inline-flex !important;
            }

            @media (max-width: 1023px) {
                [x-cloak='-lg'] {
                    display: none !important;
                }
            }

            @media (min-width: 1024px) {
                [x-cloak='lg'] {
                    display: none !important;
                }
            }
        </style>

        <link href="<%- assetUrl('fonts/navette/navette/inter/index.css') %>" rel="stylesheet" data-navigate-track />

        <%- colorVariables %>
        <% if (locals.assetStyles) { %><%- assetStyles %><% } %>

        <%# The application's compiled theme if any, otherwise the default stylesheet %>
        <link rel="stylesheet" href="<%- locals.theme ? theme : assetUrl('css/navette/navette/app.css') %>" data-navigate-track="reload" />

        <% if (font.url) { %>
            <% if (font.preconnect) { %><link rel="preconnect" href="<%- font.preconnect %>"><% } %>
            <link href="<%= font.url %>" rel="stylesheet" />
        <% } %>

        <style<%- cspNonceAttribute() %>>
            :root {
                --font-family: '<%- font.family %>';
                --font-family-mono: 'ui-monospace';
                --font-family-serif: 'ui-serif';
                --sidebar-width: <%- locals.sidebarWidth ?? '20rem' %>;
                --sidebar-collapsed-width: <%- locals.collapsedSidebarWidth ?? '4.5rem' %>;
                --default-theme-mode: system;
            }

            html.nv {
                --livewire-progress-bar-color: var(--primary-500);
            }
        </style>

        <%- renderHook('panels::styles.after', renderHookScopes) %>
        <% if (locals.darkMode === false) { %><% } else if (locals.darkModeForced) { %>
        <script<%- cspNonceAttribute() %>>
            document.documentElement.classList.add('dark')
        </script>
        <% } else { %>
        <script<%- cspNonceAttribute() %>>
            const loadDarkMode = () => {
                window.theme =
                    localStorage.getItem('navette:theme:mode') ?? <%- js(locals.defaultThemeMode ?? 'system') %>

                if (
                    window.theme === 'dark' ||
                    (window.theme === 'system' &&
                        window.matchMedia('(prefers-color-scheme: dark)')
                            .matches)
                ) {
                    document.documentElement.classList.add('dark')
                }
            }

            loadDarkMode()

            document.addEventListener('livewire:navigated', loadDarkMode)
        </script>
        <% } %>

        <% if (locals.themeCss) { %><style<%- cspNonceAttribute() %> data-navette-theme><%- themeCss %></style><% } %>

        <% if (locals.motion) { %><link rel="stylesheet" href="<%- assetUrl('navette/motion.css') %>" data-navigate-track /><% } %>
        <link rel="stylesheet" href="<%- assetUrl('navette/calendar.css') %>" data-navigate-track />
        <link rel="stylesheet" href="<%- assetUrl('navette/table-heading.css') %>" data-navigate-track />
        <% if (locals.securityKeys) { %><link rel="stylesheet" href="<%- assetUrl('navette/security-keys.css') %>" data-navigate-track /><% } %>

        <%- wireStyles %>
        <%- renderHook('panels::head.end', renderHookScopes) %>
    </head>

    <body <% if (locals.bodyAttributes) { %><%- bodyAttributes %> <% } %>class="<%- cls(['nv-body', 'nv-panel-' + panelId, bodyClass]) %>">
        <%- renderHook('panels::body.start', renderHookScopes) %>
        <%- body %>

        <%- notifications %>

        <%- renderHook('panels::scripts.before', renderHookScopes) %>
        <script<%- cspNonceAttribute() %>>
            <%- locals.scriptData ?? 'window.navetteData = []' %>
        </script>
        <% if (locals.errorNotifications) { %>
        <script<%- cspNonceAttribute() %>>
            window.navetteErrorNotifications = <%- js(errorNotifications) %>
        </script>
        <% } %>

        <% if (locals.assetScripts) { %><%- assetScripts %><% } %>
        <% for (const src of ['js/navette/actions/actions.js', 'js/navette/notifications/notifications.js', 'js/navette/schemas/schemas.js', 'js/navette/support/support.js', 'js/navette/tables/tables.js', 'js/navette/navette/echo.js', 'js/navette/navette/app.js']) { %>
            <script<%- cspNonceAttribute() %> src="<%- assetUrl(src) %>"<% if (locals.spa !== false) { %> data-navigate-once data-navigate-track<% } %>></script>
        <% } %>

        <% if (locals.broadcasting) { %>
        <script<%- cspNonceAttribute() %> src="<%- assetUrl('navette/broadcasting.js') %>" data-navigate-once></script>
        <script<%- cspNonceAttribute() %>>
            window.navetteBroadcasting.configure(<%- js(broadcasting) %>)
        </script>
        <% } %>

        <style<%- cspNonceAttribute() %>>
            :root {
            }
        </style>

        <script<%- cspNonceAttribute() %>>
            loadDarkMode()
        </script>

        <% if (locals.securityKeys) { %><script<%- cspNonceAttribute() %> src="<%- assetUrl('navette/security-keys.js') %>" data-navigate-once></script><% } %>
        <%- wireScripts %>
        <%- renderHook('panels::scripts.after', renderHookScopes) %>
        <%- renderHook('panels::body.end', renderHookScopes) %>
        <% if (locals.motion) { %><script<%- cspNonceAttribute() %> src="<%- assetUrl('navette/motion.js') %>" data-navigate-once defer></script><% } %>
    </body>
</html>
