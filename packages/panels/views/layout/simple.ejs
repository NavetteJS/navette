<%# Simple layout (login, registration…) %>
<div class="nv-simple-layout">
<% if (locals.header) { %>
    <a href="#nv-main-content" class="nv-skip-link nv-sr-only">
        <%= t('navette-panels::layout.skip_to_content.label') %>
    </a>
<% } %>
    <%- renderHook('panels::simple-layout.start', renderHookScopes) %>
<% if (locals.header) { %>
    <div class="nv-simple-layout-header"><%- header %></div>
<% } %>
    <div class="nv-simple-main-ctn">
        <main id="nv-main-content" tabindex="-1" class="nv-simple-main nv-width-<%- locals.maxContentWidth ?? 'lg' %>">
            <%- slot %>
        </main>
    </div>
    <%- renderHook('panels::footer', renderHookScopes) %>
    <%- renderHook('panels::simple-layout.end', renderHookScopes) %>
</div>
