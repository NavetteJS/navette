<%# Topbar and its navigation items %>
<div x-data="navetteSidebarBackground" x-bind:inert="$store.sidebar.isOpenMobile && ! hasOpenModal" class="nv-topbar-ctn" ><nav aria-label="<%= t('navette-panels::layout.topbar.label') %>" class="nv-topbar" >
<%- renderHook('panels::topbar.start') %>
<% if (hasNavigation) { %>
<%- view('navette::components.icon-button', {
    iconName: 'o-bars-3', iconAlias: 'panels::topbar.open-sidebar-button', iconSize: 'lg', label: t('navette-panels::layout.actions.sidebar.expand.label'), className: 'nv-topbar-open-sidebar-btn',
    extra: attrs({ 'x-cloak': 'x-cloak', 'x-data': '{}', 'aria-controls': 'nv-main-sidebar', 'x-bind:aria-expanded': '$store.sidebar.isOpen', 'x-on:click': '$store.sidebar.open($event.currentTarget)', 'x-show': '! $store.sidebar.isOpen' }),
}) %><%- view('navette::components.icon-button', {
    iconName: 'o-x-mark', iconAlias: 'panels::topbar.close-sidebar-button', iconSize: 'lg', label: t('navette-panels::layout.actions.sidebar.collapse.label'), className: 'nv-topbar-close-sidebar-btn',
    extra: attrs({ 'x-cloak': 'x-cloak', 'x-data': '{}', 'aria-controls': 'nv-main-sidebar', 'x-bind:aria-expanded': '$store.sidebar.isOpen', 'x-on:click': '$store.sidebar.close()', 'x-show': '$store.sidebar.isOpen' }),
}) %>
<% } %>
<div class="nv-topbar-start">
<% if (isSidebarCollapsibleOnDesktop || isSidebarFullyCollapsibleOnDesktop) { %>
<div x-show="$store.sidebar.isOpen || <%= isSidebarCollapsibleOnDesktop ? 'true' : 'false' %>" class="nv-topbar-collapse-sidebar-btn-ctn" >
<% if (isSidebarCollapsibleOnDesktop) { %><%- view('navette::components.icon-button', {
    iconName: 'o-chevron-right', iconAlias: 'panels::sidebar.expand-button', iconSize: 'lg', label: t('navette-panels::layout.actions.sidebar.expand.label'), className: 'nv-topbar-open-collapse-sidebar-btn',
    extra: attrs({ 'x-cloak': 'x-cloak', 'x-data': '{}', 'aria-controls': 'nv-main-sidebar', 'x-bind:aria-expanded': '$store.sidebar.isOpen', 'x-on:click': '$store.sidebar.open()', 'x-show': '! $store.sidebar.isOpen' }),
}) %><% } %><%- view('navette::components.icon-button', {
    iconName: 'o-chevron-left', iconAlias: 'panels::sidebar.collapse-button', iconSize: 'lg', label: t('navette-panels::layout.actions.sidebar.collapse.label'), className: 'nv-topbar-close-collapse-sidebar-btn',
    extra: attrs({ 'x-cloak': 'x-cloak', 'x-data': '{}', 'aria-controls': 'nv-main-sidebar', 'x-bind:aria-expanded': '$store.sidebar.isOpen', 'x-on:click': '$store.sidebar.close()', 'x-show': '$store.sidebar.isOpen' }),
}) %>
</div>
<% } %>
<%- renderHook('panels::topbar.logo.before') %><a href="<%= homeUrl %>"<% if (spa) { %> wire:navigate<% } %>><%- view('navette-panels::components.logo', { brand }) %></a><%- renderHook('panels::topbar.logo.after') %>
</div>
<% if (tenantMenu) { %><%- tenantMenu %><% } %>
<% if (topNavigation) { %>
<ul class="nv-topbar-nav-groups">
<% for (const group of topNavigation) { %>
<% if (group.label) { %>
<div x-data="navetteDropdown({ isMenu: true })"<% if (group.extraTopbarAttributes) { %> <%- group.extraTopbarAttributes %><% } %> class="nv-dropdown" ><div x-on:mousedown="if ($event.button === 0) toggle($event)" class="nv-dropdown-trigger" ><li class="<%- cls(['nv-topbar-item', { 'nv-active': group.isActive }]) %>"><button type="button" class="nv-topbar-item-btn"><span class="nv-topbar-item-label"> <%- group.labelHtml %> </span><%- icon('m-chevron-down', { alias: 'panels::topbar.group.toggle-button', attributes: attrs({ class: 'nv-topbar-group-toggle-icon' }) }) %></button></li></div><div x-cloak x-float.placement.bottom-start.flip.teleport.offset="{ offset: 8, }" x-ref="panel" x-transition:enter-start="nv-opacity-0" x-transition:leave-end="nv-opacity-0" role="menu" class="nv-dropdown-panel " style="" ><% for (const list of group.lists) { %><div class="nv-dropdown-list"><% for (const item of list) { %><a href="<%= item.url %>"<% if (item.newTab) { %> target="_blank"<% } else if (spa) { %> wire:navigate<% } %><% if (item.isActive) { %> aria-current="page"<% } %><% if (item.extraAttributes) { %> <%- item.extraAttributes %><% } %> class="<%- cls(['nv-dropdown-list-item', ...item.colorClasses]) %>" role="menuitem" tabindex="-1"><% if (item.icon) { %><%- icon(item.icon, item.isActive ? { attributes: attrs({ class: 'nv-color nv-color-primary' }) } : {}) %><% } %><span class="nv-dropdown-list-item-label"><%- item.labelHtml %></span><% if (item.badge !== null) { %><%- view('navette::components.badge', { label: item.badge, colorClasses: item.badgeColorClasses, tooltip: item.badgeTooltip }) %><% } %></a><% } %></div><% } %></div></div>
<% } else { %>
<% for (const item of group.items) { %><li<% if (item.extraAttributes) { %> <%- item.extraAttributes %><% } %> class="<%- cls(['nv-topbar-item', { 'nv-active': item.isActive }]) %>"><a href="<%= item.url %>"<% if (item.newTab) { %> target="_blank"<% } else if (spa) { %> wire:navigate<% } %><% if (item.isActive) { %> aria-current="page"<% } %> class="nv-topbar-item-btn"><% if (item.icon) { %><%- icon(item.icon, { attributes: attrs({ class: 'nv-topbar-item-icon' }) }) %><% } %><span class="nv-topbar-item-label"> <%- item.labelHtml %> </span><% if (item.badge !== null) { %><%- view('navette::components.badge', { label: item.badge, colorClasses: item.badgeColorClasses, tooltip: item.badgeTooltip }) %><% } %></a></li><% } %>
<% } %>
<% } %>
</ul>
<% } %>
<div x-persist="<%= persistKey %>" class="nv-topbar-end" >
<%- renderHook('panels::global-search.before') %><%- globalSearch ?? '' %><%- renderHook('panels::global-search.after') %>
<%- databaseNotifications ?? '' %>
<%- userMenu ?? '' %>
</div>
<%- renderHook('panels::topbar.end') %>
</nav><%- actionModals %></div>
