<%# Sidebar: navigation groups and items %>
<% const collapsible = isSidebarCollapsibleOnDesktop || isSidebarFullyCollapsibleOnDesktop; %>
<%# With a sidebar collapsible to icons, labels and badges are only shown while it is open. %>
<% const transition = ' x-transition:enter="nv-transition-enter" x-transition:enter-start="nv-transition-enter-start" x-transition:enter-end="nv-transition-enter-end"'; %>
<% const sidebarTransition = isSidebarCollapsibleOnDesktop ? ` x-show="$store.sidebar.isOpen"${transition}` : ''; %>
<%# One item, with its child items below it when it has no URL, is active, or one of them is. %>
<% const sidebarItem = (item, { grouped, subGrouped = false, first, last }) => { %>
                                <li<% if (item.extraAttributes) { %> <%- item.extraAttributes %><% } %> class="<%- cls(['nv-sidebar-item', { 'nv-active': item.isActive, 'nv-sidebar-item-has-active-child-items': item.activeChildItems, 'nv-sidebar-item-has-url': Boolean(item.url) }]) %>">
                                    <a<% if (item.url) { %> href="<%= item.url %>"<% if (item.newTab) { %> target="_blank"<% } else if (spa && item.spa) { %> wire:navigate<% } %><% } %><% if (item.isActive) { %> aria-current="page"<% } %> x-on:click="$store.sidebar.isMobile && $store.sidebar.close()"<% if (isSidebarCollapsibleOnDesktop) { %> x-bind:aria-label="$store.sidebar.isOpen ? null : <%= js(item.label) %>" x-data="navetteSidebarTooltip" x-tooltip="getTooltip({ content: <%= js(item.isHtmlLabel ? item.labelHtml : item.label) %>, allowHTML: <%= item.isHtmlLabel ? 'true' : 'false' %>, })"<% } %> class="nv-sidebar-item-btn">
                                        <% if (item.icon && (!subGrouped || isSidebarCollapsibleOnDesktop)) { %><%- icon(item.icon, { size: 'lg', attributes: attrs({ class: 'nv-sidebar-item-icon', 'x-show': subGrouped ? '! $store.sidebar.isOpen' : false }) }) %><% } %>
                                        <% if ((!item.icon && grouped) || subGrouped) { %>
                                            <div<% if (item.icon && subGrouped && isSidebarCollapsibleOnDesktop) { %> x-show="$store.sidebar.isOpen"<% } %> class="nv-sidebar-item-grouped-border">
                                                <% if (!first) { %><div class="nv-sidebar-item-grouped-border-part-not-first"></div><% } %>
                                                <% if (!last) { %><div class="nv-sidebar-item-grouped-border-part-not-last"></div><% } %>
                                                <div class="nv-sidebar-item-grouped-border-part"></div>
                                            </div>
                                        <% } %>
                                        <span<%- sidebarTransition %> class="nv-sidebar-item-label">
                                            <%- item.labelHtml %>
                                        </span>
                                        <% if (item.badge !== null) { %>
                                            <span<%- sidebarTransition %> class="nv-sidebar-item-badge-ctn">
                                                <%- view('navette::components.badge', { label: item.badge, colorClasses: item.badgeColorClasses, tooltip: item.badgeTooltip }) %>
                                            </span>
                                        <% } %>
                                    </a>
                                    <% if (item.childItems?.length && (!item.url || item.isActive || item.activeChildItems)) { %>
                                        <ul class="nv-sidebar-sub-group-items">
                                            <% item.childItems.forEach((child, index) => sidebarItem(child, { grouped: true, subGrouped: true, first: index === 0, last: index === item.childItems.length - 1 })) %>
                                        </ul>
                                    <% } %>
                                </li>
<% } %>
<div>
    <div x-data="navetteSidebar({
            hasTopNavigation: <%= hasTopNavigation ? 'true' : 'false' %>,
            isSidebarCollapsibleOnDesktop: <%= isSidebarCollapsibleOnDesktop ? 'true' : 'false' %>,
            isSidebarFullyCollapsibleOnDesktop: <%= isSidebarFullyCollapsibleOnDesktop ? 'true' : 'false' %>,
        })" <% if (collapsible) { %>x-cloak<% } else { %>x-cloak="-lg"<% } %> x-bind:class="{ 'nv-sidebar-open': $store.sidebar.isOpen }" x-bind:inert="isHidden" x-effect="focusInitialNavigation()" x-on:keydown.tab="handleTab($event)" x-on:keydown.escape.document="handleEscape($event)" id="nv-main-sidebar" class="nv-sidebar nv-main-sidebar">
        <%- renderHook('panels::sidebar.start') %>
        <div class="nv-sidebar-header-ctn">
            <header class="nv-sidebar-header">
<% if (!hasTopbar && isSidebarCollapsibleOnDesktop) { %>
                <%- view('navette::components.icon-button', {
                    iconName: 'o-chevron-right', iconAlias: 'panels::sidebar.expand-button', iconSize: 'lg', label: t('navette-panels::layout.actions.sidebar.expand.label'), className: 'nv-sidebar-open-collapse-sidebar-btn',
                    extra: attrs({ 'x-cloak': 'x-cloak', 'x-data': '{}', 'aria-controls': 'nv-main-sidebar', 'x-bind:aria-expanded': '$store.sidebar.isOpen', 'x-on:click': '$store.sidebar.open()', 'x-show': '! $store.sidebar.isOpen' }),
                }) %>
<% } %>
<% if (!hasTopbar && collapsible) { %>
                <%- view('navette::components.icon-button', {
                    iconName: 'o-chevron-left', iconAlias: 'panels::sidebar.collapse-button', iconSize: 'lg', label: t('navette-panels::layout.actions.sidebar.collapse.label'), className: 'nv-sidebar-close-collapse-sidebar-btn',
                    extra: attrs({ 'x-cloak': 'x-cloak', 'x-data': '{}', 'aria-controls': 'nv-main-sidebar', 'x-bind:aria-expanded': '$store.sidebar.isOpen', 'x-on:click': '$store.sidebar.close()', 'x-show': '$store.sidebar.isOpen' }),
                }) %>
<% } %>
                <%- renderHook('panels::sidebar.logo.before') %>
                <div<% if (collapsible) { %> x-show="$store.sidebar.isOpen"<% } %> class="nv-sidebar-header-logo-ctn">
                    <a href="<%= homeUrl %>"<% if (spa) { %> wire:navigate<% } %>>
                        <%- view('navette-panels::components.logo', { brand }) %>
                    </a>
                </div>
                <%- renderHook('panels::sidebar.logo.after') %>
            </header>
        </div>
<% if (tenantMenu || globalSearch) { %>
        <div<% if (!tenantMenu && collapsible) { %> x-show="$store.sidebar.isOpen"<% } %> class="nv-sidebar-header-controls">
<% if (tenantMenu) { %><%- tenantMenu %><% } %>
<% if (globalSearch) { %>            <div<% if (collapsible) { %> x-show="$store.sidebar.isOpen"<% } %>><%- globalSearch %></div>
<% } %>
        </div>
<% } %>

        <nav aria-label="<%= t('navette-panels::layout.navigation.label') %>" class="nv-sidebar-nav">
            <%- renderHook('panels::sidebar.nav.start') %>
            <ul class="nv-sidebar-nav-groups">
                <% for (const group of groups) { %>
                    <li x-data="{ label: <%- js(group.key ?? '') %> }" data-group-label="<%= group.key ?? '' %>" x-bind:class="{ 'nv-collapsed': $store.sidebar.groupIsCollapsed(label) }"<% if (group.extraSidebarAttributes) { %> <%- group.extraSidebarAttributes %><% } %> class="<%- cls(['nv-sidebar-group', { 'nv-active': group.isActive, 'nv-collapsible': group.collapsible !== false }]) %>">
                        <% if (group.label) { %>
                            <div<% if (group.collapsible !== false) { %> x-on:click="$store.sidebar.toggleCollapsedGroup(label)"<% } %><%- sidebarTransition %> class="nv-sidebar-group-btn">
                                <% if (group.icon) { %><%- icon(group.icon, { size: 'lg' }) %><% } %>
                                <span class="nv-sidebar-group-label">
                                    <%- group.labelHtml %>
                                </span>
                                <% if (group.collapsible !== false) { %><%- view('navette::components.icon-button', {
                                    iconName: 'm-chevron-up', iconAlias: 'panels::sidebar.group.collapse-button', label: group.label, className: 'nv-sidebar-group-collapse-btn',
                                    extra: attrs({ 'aria-controls': group.itemsId, 'x-bind:aria-expanded': '! $store.sidebar.groupIsCollapsed(label)', 'x-on:click.stop': '$store.sidebar.toggleCollapsedGroup(label)' }),
                                }) %><% } %>
                            </div>
                        <% } %>
                        <% if (group.lists) { %>
                            <div x-data="navetteDropdown({ isMenu: true })" x-show="! $store.sidebar.isOpen" class="nv-dropdown">
                                <div x-on:mousedown="if ($event.button === 0) toggle($event)" class="nv-dropdown-trigger">
                                    <button aria-label="<%= group.label %>" x-data="navetteSidebarTooltip" x-tooltip="getTooltip({ content: <%= js(group.isHtmlLabel ? group.labelHtml : group.label) %>, allowHTML: <%= group.isHtmlLabel ? 'true' : 'false' %>, })" class="nv-sidebar-group-dropdown-trigger-btn">
                                        <%- icon(group.icon, { size: 'lg' }) %>
                                    </button>
                                </div>
                                <div x-cloak x-float.placement.<%= t('navette-panels::layout.direction') === 'rtl' ? 'left-start' : 'right-start' %>.flip.offset="{ offset: 8,  }" x-ref="panel" x-transition:enter-start="nv-opacity-0" x-transition:leave-end="nv-opacity-0" role="menu" class="nv-dropdown-panel " style="">
                                    <div class="nv-dropdown-header">
                                        <span>
                                            <%- group.labelHtml %>
                                        </span>
                                    </div>
                                    <% for (const list of group.lists) { %>
                                        <div class="nv-dropdown-list">
                                            <% for (const item of list) { %><a href="<%= item.url %>"<% if (item.newTab) { %> target="_blank"<% } else if (spa && item.spa) { %> wire:navigate<% } %><% if (item.isActive) { %> aria-current="page"<% } %><% if (item.extraAttributes) { %> <%- item.extraAttributes %><% } %> class="<%- cls(['nv-dropdown-list-item', ...item.colorClasses]) %>" role="menuitem" tabindex="-1"><% if (item.icon) { %><%- icon(item.icon, item.isActive ? { attributes: attrs({ class: 'nv-color nv-color-primary' }) } : {}) %><% } %><span class="nv-dropdown-list-item-label"><%- item.labelHtml %></span><% if (item.badge !== null) { %><%- view('navette::components.badge', { label: item.badge, colorClasses: item.badgeColorClasses, tooltip: item.badgeTooltip }) %><% } %></a><% } %>
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                        <% } %>
                        <ul<% if (group.label) { %> id="<%= group.itemsId %>"<% if (isSidebarCollapsibleOnDesktop) { %> x-show="$store.sidebar.isOpen ? ! $store.sidebar.groupIsCollapsed(label) : ! <%= group.lists ? 'true' : 'false' %>" x-collapse.duration.200ms<% } else if (group.collapsible !== false) { %> x-show="! $store.sidebar.groupIsCollapsed(label)" x-collapse.duration.200ms<% } %><% } %><%- isSidebarCollapsibleOnDesktop ? transition : '' %> class="nv-sidebar-group-items">
                            <% group.items.forEach((item, index) => sidebarItem(item, { grouped: Boolean(group.label), first: index === 0, last: index === group.items.length - 1 })) %>
                        </ul>
                    </li>
                <% } %>
            </ul>

            <script<%- cspNonceAttribute() %>>
                if (! window.Alpine?.store('sidebar')) {
                    let collapsedGroups = JSON.parse(
                        localStorage.getItem('navette:sidebar:collapsed_groups'),
                    )

                    if (collapsedGroups === null || collapsedGroups === 'null') {
                        collapsedGroups = <%- js(groups.filter((group) => group.collapsed && group.label).map((group) => group.key)) %>

                        localStorage.setItem(
                            'navette:sidebar:collapsed_groups',
                            JSON.stringify(collapsedGroups),
                        )
                    }

                    document.currentScript
                        .closest('nav')
                        .querySelectorAll('.nv-sidebar-group')
                        .forEach((group) => {
                            if (! collapsedGroups.includes(group.dataset.groupLabel)) {
                                return
                            }

                            // Hide collapsed groups before Alpine initializes to avoid a flash.
                            group.querySelector('.nv-sidebar-group-items').style.display = 'none'
                            group.classList.add('nv-collapsed')
                        })
                }
            </script>
            <%- renderHook('panels::sidebar.nav.end') %>
        </nav>

<% if (databaseNotifications || userMenu) { %>
        <div class="nv-sidebar-footer">
            <%- databaseNotifications ?? '' %>
            <%- userMenu ?? '' %>
        </div>
<% } %>
        <%# Rendered after the sidebar footer, not inside it. %>
        <%- renderHook('panels::sidebar.footer') %>
    </div>

    <%- actionModals %>
</div>
