<%# Simple page: logo, header and content %>
<div class="nv-simple-page">
    <%- renderHook('panels::simple-page.start', renderHookScopes) %>
    <div class="nv-simple-page-content">
        <% if (heading || locals.hasLogo !== false || locals.subheading) { %>
        <header class="nv-simple-header">
            <% if (locals.hasLogo !== false) { %>
            <%- view('navette-panels::components.logo', { brand }) %>
            <% } %>

            <% if (heading) { %>
            <h1 class="nv-simple-header-heading">
                <%= heading %>
            </h1>
            <% } %>

            <% if (locals.subheading) { %>
            <p class="nv-simple-header-subheading">
                <%- subheading %>
            </p>
            <% } %>
        </header>
        <% } %>

        <%- content %>
    </div>

    <% if (locals.actionModals) { %>
    <%- actionModals %>
    <% } else { %>
    <div wire:partial="action-modals" x-data="navetteActionModals({
                    livewireId: <%- js(livewireId) %>,
                })" style="height: 0"></div>
    <% } %>
    <%- renderHook('panels::simple-page.end', renderHookScopes) %>
</div>
