<%# Page d'un panel — port de filament-panels::components.page.index, components.header.index et filament::components.breadcrumbs %>
<% const beforeHeaderActions = renderHook('panels::page.header.actions.before', renderHookScopes), afterHeaderActions = renderHook('panels::page.header.actions.after', renderHookScopes); %>
<% const subNavigation = locals.subNavigation ?? []; const activeSubItem = subNavigation.find((item) => item.active) ?? subNavigation[0]; const subNavigationPosition = locals.subNavigationPosition ?? 'top'; %>
<div class="<%- cls(['fi-page', subNavigation.length ? `fi-page-has-sub-navigation fi-page-has-sub-navigation-${subNavigationPosition}` : null, ...(locals.pageClasses ?? [])]) %>">
    <%- renderHook('panels::page.start', renderHookScopes) %>
    <div class="fi-page-header-main-ctn">
        <% if (subNavigation.length) { %>
            <%# Sous-navigation : menu déroulant sur mobile ; sur grand écran, onglets (top) ou colonne (start, end) %>
            <div class="fi-page-main-sub-navigation-mobile-menu-render-hook-ctn"><%- renderHook('panels::page.sub-navigation.module-menu.before', renderHookScopes) %></div>
            <div x-data="filamentDropdown({ isMenu: true })" class="fi-dropdown fi-page-sub-navigation-dropdown">
                <div x-on:mousedown="if ($event.button === 0) toggle($event)" class="fi-dropdown-trigger">
                    <button class="fi-btn fi-size-md" type="button" wire:loading.attr="aria-disabled" wire:loading.class="fi-disabled"><%= activeSubItem.label %><%- icon('m-chevron-down') %></button>
                </div>
                <div x-cloak x-float.placement.bottom-start.flip.offset="{ offset: 8, }" x-ref="panel" x-transition:enter-start="fi-opacity-0" x-transition:leave-end="fi-opacity-0" role="menu" class="fi-dropdown-panel fi-width-xs" style="">
                    <div class="fi-dropdown-list">
                        <% for (const item of subNavigation) { %>
                            <a href="<%= item.url %>" wire:navigate class="fi-dropdown-list-item" role="menuitem" tabindex="-1"<% if (item.active) { %> aria-current="page"<% } %>><% if (item.icon) { %><%- icon(item.icon) %><% } %><span class="fi-dropdown-list-item-label"><%= item.label %></span></a>
                        <% } %>
                    </div>
                </div>
            </div>
            <div class="fi-page-main-sub-navigation-mobile-menu-render-hook-ctn"><%- renderHook('panels::page.sub-navigation.module-menu.after', renderHookScopes) %></div>
        <% } %>
        <header class="<%- cls(['fi-header', { 'fi-header-has-breadcrumbs': breadcrumbs.length }]) %>">
            <div>
                <% if (breadcrumbs.length) { %>
                    <nav class="fi-breadcrumbs" aria-label="<%= t('filament::components/breadcrumbs.label') %>">
                        <ol class="fi-breadcrumbs-list">
                            <% breadcrumbs.forEach((crumb, i) => { %>
                                <li class="fi-breadcrumbs-item">
                                    <% if (i > 0) { %>
                                        <%- icon('m-chevron-right', { attributes: attrs({ 'aria-hidden': 'true', class: 'fi-breadcrumbs-item-separator fi-ltr' }) }) %>
                                        <%- icon('m-chevron-left', { attributes: attrs({ 'aria-hidden': 'true', class: 'fi-breadcrumbs-item-separator fi-rtl' }) }) %>
                                    <% } %>
                                    <% if (crumb.url) { %>
                                        <a href="<%= crumb.url %>" wire:navigate class="fi-breadcrumbs-item-label">
                                            <%= crumb.label %>
                                        </a>
                                    <% } else { %>
                                        <span<% if (i === breadcrumbs.length - 1) { %> aria-current="page"<% } %> class="fi-breadcrumbs-item-label">
                                            <%= crumb.label %>
                                        </span>
                                    <% } %>
                                </li>
                            <% }) %>
                        </ol>
                    </nav>
                <% } %>

                <%- renderHook('panels::page.header.heading.before', renderHookScopes) %>
                <h1 class="fi-header-heading">
                    <%= heading %>
                </h1>
                <%- renderHook('panels::page.header.heading.after', renderHookScopes) %>
            </div>

            <%# Comme Filament : le conteneur existe dès qu'il y a une action ou qu'un des deux emplacements rend quelque chose. %>
            <% if (headerActions.length || (beforeHeaderActions + afterHeaderActions).trim() !== '') { %>
                <div class="fi-header-actions-ctn">
                    <%- beforeHeaderActions %>
                    <% if (headerActions.length) { %>
                    <div class="fi-ac fi-align-start" wire:key="<%= livewireId %>.header-actions.<%- headerActionsKey %>">
                        <%- headerActions.join('') %>
                    </div>
                    <% } %>
                    <%- afterHeaderActions %>
                </div>
            <% } %>
        </header>

        <div class="fi-page-main">
            <% if (subNavigation.length && subNavigationPosition === 'start') { %>
                <%- renderHook('panels::page.sub-navigation.start.before', renderHookScopes) %>
                <div class="fi-page-sub-navigation-sidebar-ctn">
                    <%- renderHook('panels::page.sub-navigation.sidebar.before', renderHookScopes) %>
                    <ul class="fi-page-sub-navigation-sidebar">
                        <li x-data="{ label: 'sub_navigation_' }" data-group-label="sub_navigation_" x-bind:class="{ 'fi-collapsed': $store.sidebar.groupIsCollapsed(label) }" class="<%- cls(['fi-sidebar-group', { 'fi-active': subNavigation.some((item) => item.active) }, 'fi-collapsible']) %>">
                            <ul class="fi-sidebar-group-items">
                                <% for (const item of subNavigation) { %>
                                    <li class="<%- cls(['fi-sidebar-item', { 'fi-active': item.active }, 'fi-sidebar-item-has-url']) %>">
                                        <a href="<%= item.url %>" wire:navigate<% if (item.active) { %> aria-current="page"<% } %> x-on:click="$store.sidebar.isMobile && $store.sidebar.close()" class="fi-sidebar-item-btn">
                                            <% if (item.icon) { %><%- icon(item.icon, { size: 'lg', attributes: attrs({ class: 'fi-sidebar-item-icon' }) }) %><% } %>
                                            <span class="fi-sidebar-item-label">
                                                <%= item.label %>
                                            </span>
                                        </a>
                                    </li>
                                <% } %>
                            </ul>
                        </li>
                    </ul>
                    <%- renderHook('panels::page.sub-navigation.sidebar.after', renderHookScopes) %>
                </div>
                <%- renderHook('panels::page.sub-navigation.start.after', renderHookScopes) %>
            <% } %>
            <% if (subNavigation.length && subNavigationPosition === 'top') { %>
                <%- renderHook('panels::page.sub-navigation.top.before', renderHookScopes) %>
                <nav class="fi-tabs fi-page-sub-navigation-tabs" aria-label="<%= t('filament::components/tabs.label') %>">
                    <% for (const item of subNavigation) { %>
                        <a href="<%= item.url %>" wire:navigate class="<%- cls(['fi-tabs-item', { 'fi-active': item.active }]) %>"<% if (item.active) { %> aria-current="page"<% } %>><% if (item.icon) { %><%- icon(item.icon) %><% } %><span class="fi-tabs-item-label"><%= item.label %></span></a>
                    <% } %>
                </nav>
                <%- renderHook('panels::page.sub-navigation.top.after', renderHookScopes) %>
            <% } %>
            <div class="fi-page-content">
                <%- renderHook('panels::page.header-widgets.before', renderHookScopes) %>
                <%- headerWidgets %>
                <%- renderHook('panels::page.header-widgets.after', renderHookScopes) %>
                <%- content %>
                <%- renderHook('panels::page.footer-widgets.before', renderHookScopes) %>
                <%- locals.footerWidgets ?? '' %>
                <%- renderHook('panels::page.footer-widgets.after', renderHookScopes) %>
            </div>
            <% if (subNavigation.length && subNavigationPosition === 'end') { %>
                <%- renderHook('panels::page.sub-navigation.end.before', renderHookScopes) %>
                <div class="fi-page-sub-navigation-sidebar-ctn">
                    <%- renderHook('panels::page.sub-navigation.sidebar.before', renderHookScopes) %>
                    <ul class="fi-page-sub-navigation-sidebar">
                        <li x-data="{ label: 'sub_navigation_' }" data-group-label="sub_navigation_" x-bind:class="{ 'fi-collapsed': $store.sidebar.groupIsCollapsed(label) }" class="<%- cls(['fi-sidebar-group', { 'fi-active': subNavigation.some((item) => item.active) }, 'fi-collapsible']) %>">
                            <ul class="fi-sidebar-group-items">
                                <% for (const item of subNavigation) { %>
                                    <li class="<%- cls(['fi-sidebar-item', { 'fi-active': item.active }, 'fi-sidebar-item-has-url']) %>">
                                        <a href="<%= item.url %>" wire:navigate<% if (item.active) { %> aria-current="page"<% } %> x-on:click="$store.sidebar.isMobile && $store.sidebar.close()" class="fi-sidebar-item-btn">
                                            <% if (item.icon) { %><%- icon(item.icon, { size: 'lg', attributes: attrs({ class: 'fi-sidebar-item-icon' }) }) %><% } %>
                                            <span class="fi-sidebar-item-label">
                                                <%= item.label %>
                                            </span>
                                        </a>
                                    </li>
                                <% } %>
                            </ul>
                        </li>
                    </ul>
                    <%- renderHook('panels::page.sub-navigation.sidebar.after', renderHookScopes) %>
                </div>
                <%- renderHook('panels::page.sub-navigation.end.after', renderHookScopes) %>
            <% } %>
        </div>
    </div>

    <%- actionModals %>
    <%- renderHook('panels::page.end', renderHookScopes) %>
</div>
