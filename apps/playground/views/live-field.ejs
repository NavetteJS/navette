<div class="card">
    <h2>Live field and Alpine binding</h2>
    <form wire:submit="add">
        <input type="text" wire:model.live.debounce.150ms="name" placeholder="Name" data-test="name" />
        <button type="submit" data-test="add">Add</button>
    </form>
    <% if (errors.name) { %><p class="error" data-test="error"><%= errors.name[0] %></p><% } %>
    <p>Server preview: <strong data-test="preview"><%= name.toUpperCase() %></strong></p>
    <ul>
        <% items.forEach((item, i) => { %>
            <li wire:key="item-<%= i %>-<%= item %>"><%= item %> <button type="button" wire:click="remove(<%= i %>)" data-test="remove">×</button></li>
        <% }) %>
    </ul>
    <div x-data="{ open: $wire.entangle('open') }">
        <button type="button" x-on:click="open = !open" data-test="toggle">Toggle (Alpine state bound to the server)</button>
        <span data-test="open-client" x-text="open ? 'open' : 'closed'"></span>
        — as seen by the server on the last render: <span data-test="open-server"><%= open ? 'open' : 'closed' %></span>
        <button type="button" wire:click="$refresh" data-test="refresh">Sync</button>
    </div>
</div>
