<%# Scènes « components/modal » — même page que docs-assets/app (modal.blade.php). Contenus libres repris de la vue Blade. %>
<% const livewireId = 'Navette0Scene0Demo12'; const gray = (label) => ui.button({ color: 'gray' }, label); %>
<%- ui.modal({ id: 'demo-modal', livewireId, heading: 'Confirm your action', description: 'Are you sure you want to proceed? This action cannot be undone.', footerActions: [ui.button({}, 'Confirm'), gray('Cancel')] }) %>
<%- ui.modal({ id: 'demo-modal-icon', livewireId, icon: 'heroicon-o-exclamation-triangle', iconColor: 'danger', heading: 'Delete record', description: 'Are you sure you would like to do this?', footerActions: [ui.button({ color: 'danger' }, 'Confirm'), gray('Cancel')] }) %>
<%- ui.modal({ id: 'demo-modal-slide-over', livewireId, slideOver: true, heading: 'Edit user', description: "Update the user's profile information below.", footerActions: [ui.button({}, 'Save changes'), gray('Cancel')] }, "<p class=\"text-sm text-gray-500 dark:text-gray-400\">\n        This is the slide-over content area. You can add forms, text, or any other content here. The slide-over panel slides in from the right side of the screen.\n    </p>") %>
<%- ui.modal({ id: 'demo-modal-heading', livewireId, heading: 'Edit your profile', description: 'Update your account details and preferences below.', footerActions: [ui.button({}, 'Save changes'), gray('Cancel')] }, "<p class=\"text-sm text-gray-500 dark:text-gray-400\">Your profile information will be visible to other users in your organization.</p>") %>
<%- ui.modal({ id: 'demo-modal-eyebrow', livewireId, eyebrow: 'Publish post', heading: 'Getting started with Filament', description: 'This post will be visible to everyone. You can continue editing it after publishing.', footerActions: [ui.button({}, 'Publish'), gray('Cancel')] }) %>
<%- ui.modal({ id: 'demo-modal-footer', livewireId, heading: 'Edit profile', description: 'Update your account details below.', footer: '<div class="flex items-center justify-between w-full">' + ui.link({ href: '#', color: 'gray', size: 'sm' }, 'Need help?') + '<div class="flex gap-x-3">' + gray('Cancel') + ui.button({}, 'Save changes') + '</div></div>' }, "<p class=\"text-sm text-gray-500 dark:text-gray-400\">Your profile information will be visible to other users in your organization. Please ensure all details are accurate and up to date.</p>") %>
<%- ui.modal({ id: 'demo-modal-alignment', livewireId, alignment: 'center', heading: 'Payment successful', description: 'Your payment of $49.99 has been processed successfully. A confirmation email has been sent to your inbox.', footerActions: [ui.button({}, 'View receipt'), gray('Close')] }) %>
<%- ui.modal({ id: 'demo-modal-width', livewireId, width: '5xl', heading: 'Activity log', description: 'Review recent changes made to this resource.', footerActions: [gray('Close')] }, "<div class=\"overflow-hidden rounded-xl border border-gray-200 dark:border-white/10\">\n        <table class=\"w-full table-fixed text-sm text-start\">\n            <thead>\n                <tr class=\"bg-gray-50 dark:bg-white/5\">\n                    <th class=\"px-4 py-2 text-start font-medium text-gray-600 dark:text-gray-400\">User</th>\n                    <th class=\"px-4 py-2 text-start font-medium text-gray-600 dark:text-gray-400\">Action</th>\n                    <th class=\"px-4 py-2 text-start font-medium text-gray-600 dark:text-gray-400\">Resource</th>\n                    <th class=\"px-4 py-2 text-start font-medium text-gray-600 dark:text-gray-400\">Date</th>\n                </tr>\n            </thead>\n            <tbody class=\"divide-y divide-gray-200 dark:divide-white/10\">\n                <tr>\n                    <td class=\"px-4 py-2 text-gray-950 dark:text-white\">Dan Harrin</td>\n                    <td class=\"px-4 py-2 text-gray-500 dark:text-gray-400\">Updated status</td>\n                    <td class=\"px-4 py-2 text-gray-500 dark:text-gray-400\">Post #142</td>\n                    <td class=\"px-4 py-2 text-gray-500 dark:text-gray-400\">Mar 15, 2026</td>\n                </tr>\n                <tr>\n                    <td class=\"px-4 py-2 text-gray-950 dark:text-white\">Ryan Chandler</td>\n                    <td class=\"px-4 py-2 text-gray-500 dark:text-gray-400\">Created record</td>\n                    <td class=\"px-4 py-2 text-gray-500 dark:text-gray-400\">Post #143</td>\n                    <td class=\"px-4 py-2 text-gray-500 dark:text-gray-400\">Mar 14, 2026</td>\n                </tr>\n                <tr>\n                    <td class=\"px-4 py-2 text-gray-950 dark:text-white\">Zep Fietje</td>\n                    <td class=\"px-4 py-2 text-gray-500 dark:text-gray-400\">Deleted record</td>\n                    <td class=\"px-4 py-2 text-gray-500 dark:text-gray-400\">Post #139</td>\n                    <td class=\"px-4 py-2 text-gray-500 dark:text-gray-400\">Mar 13, 2026</td>\n                </tr>\n            </tbody>\n        </table>\n    </div>") %>
