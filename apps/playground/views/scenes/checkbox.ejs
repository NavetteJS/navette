<%# Scène « components/checkbox » %>
<div id="checkboxSimple" class="p-8 max-w-md space-y-3">
    <% for (const [checked, label] of [[true, 'Send email notifications'], [false, 'Enable two-factor authentication'], [true, 'Accept terms and conditions']]) { %>
        <label class="flex items-center gap-3">
            <%- ui.checkbox({ checked }) %>
            <span class="text-sm font-medium text-gray-700 dark:text-gray-200"><%= label %></span>
        </label>
    <% } %>
</div>
