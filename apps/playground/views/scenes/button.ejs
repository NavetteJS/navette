<div id="buttonSimple" class="p-8 flex items-center justify-center max-w-xl">
    <%- ui.button({}, 'New user') %>
</div>

<div id="buttonSizes" class="p-8 flex items-center gap-4 max-w-2xl">
    <%- ui.button({ size: 'xs' }, 'Extra small') %>
    <%- ui.button({ size: 'sm' }, 'Small') %>
    <%- ui.button({}, 'Medium') %>
    <%- ui.button({ size: 'lg' }, 'Large') %>
    <%- ui.button({ size: 'xl' }, 'Extra large') %>
</div>

<div id="buttonColors" class="p-8 flex items-center gap-4 max-w-2xl">
    <% for (const color of ['primary', 'success', 'info', 'warning', 'danger', 'gray']) { %>
        <%- ui.button({ color }, color[0].toUpperCase() + color.slice(1)) %>
    <% } %>
</div>

<div id="buttonOutlined" class="p-8 flex items-center gap-4 max-w-2xl">
    <% for (const color of ['primary', 'success', 'danger', 'gray']) { %>
        <%- ui.button({ color, outlined: true }, color[0].toUpperCase() + color.slice(1)) %>
    <% } %>
</div>

<div id="buttonIcon" class="p-8 flex items-center gap-4 max-w-xl">
    <%- ui.button({ icon: 'heroicon-m-sparkles' }, 'Star') %>
    <%- ui.button({ icon: 'heroicon-m-pencil-square', iconPosition: 'after' }, 'Edit') %>
</div>

<div id="buttonOutlinedColors" class="p-8 flex flex-wrap items-center gap-3 max-w-2xl">
    <% for (const color of ['primary', 'success', 'info', 'warning', 'danger', 'gray']) { %>
        <%- ui.button({ color, outlined: true }, color[0].toUpperCase() + color.slice(1)) %>
    <% } %>
</div>

<div id="buttonBadge" class="p-8 flex items-center gap-4 max-w-xl">
    <%- ui.button({ badge: 3 }, 'Notifications') %>
    <%- ui.button({ badge: 5, badgeColor: 'danger' }, 'Errors') %>
</div>
